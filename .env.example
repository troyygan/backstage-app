# Example environment variables for backstage-app. Copy to a local `.env` for
# local development, or set these in Portainer → stack → env vars for the
# deployed container. NEVER commit real values.

# Browser-facing base URL (dev = http://192.168.1.30:7007, core = http://backstage.homelab.lan)
BACKSTAGE_APP_URL=http://localhost:7007

# Postgres on docker-data-01 (shared homelab server)
POSTGRES_HOST=192.168.1.32
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-me

# GitHub PAT with `repo` scope (catalog fetches + TechDocs cloning)
GITHUB_TOKEN=ghp_change_me
