# Example environment variables for backstage-app. Copy to a local `.env` for
# local development, or set these in Portainer → stack → env vars for the
# deployed container. NEVER commit real values.

# Browser-facing base URL (dev = https://192.168.1.30:7007, core = https://backstage.homelab.lan)
BACKSTAGE_APP_URL=http://localhost:7007

# false on core (Traefik terminates TLS); unset/true elsewhere (direct HTTPS)
# BACKSTAGE_HTTPS=true

# Postgres on docker-data-01 (shared homelab server)
POSTGRES_HOST=192.168.1.32
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-me

# GitHub PAT with `repo` scope (catalog fetches + TechDocs cloning)
GITHUB_TOKEN=ghp_change_me

# GitHub OAuth App (Backstage sign-in) — https://github.com/settings/developers
AUTH_GITHUB_CLIENT_ID=change_me
AUTH_GITHUB_CLIENT_SECRET=change_me

# MCP actions endpoint static token (Authorization: Bearer <token>)
BACKSTAGE_MCP_TOKEN=change_me

# MinIO (docker-data-01) — TechDocs S3 publisher
MINIO_ROOT_USER=homelab
MINIO_ROOT_PASSWORD=change_me
